{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amarbanerjee23-github-io",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://amarbanerjee23.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
