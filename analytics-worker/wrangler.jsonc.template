{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dr-amar-banerjee-portfolio-analytics",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://amarbanerjee23.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-analytics",
      "database_id": "__D1_DATABASE_ID__"
    }
  ]
}
